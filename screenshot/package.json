{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "screenshot",
  "title": "screenshot",
  "description": "make screenshots on linux",
  "categories": [],
  "license": "MIT",
  "author": "zspher",
  "contributors": [],
  "pastContributors": [],
  "icon": "drawing.svg",
  "commands": [
    {
      "name": "screenshot",
      "title": "screenshot",
      "subtitle": "screenshot",
      "description": "make a screenshot",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "editor",
      "title": "Editor",
      "description": "Editor used to annotate screenshots",
      "required": true,
      "type": "textfield",
      "default": "gimp"
    },
    {
      "name": "saveDir",
      "title": "Screenshot Directory",
      "description": "Directory where screenshots are saved",
      "required": true,
      "type": "directory",
      "default": "~/Pictures/Screenshots"
    },
    {
      "name": "saveFormat",
      "title": "Filename Format",
      "description": "Date format passed to the Linux date utility when generating screenshot filenames",
      "required": true,
      "type": "textfield",
      "default": "%Y-%m-%dT%H-%M-%S"
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "format": "biome format --write src",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.22.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
